<Window x:Class="ChessUI.OnlineWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ChessUI"
        Title="Chess — Online" Width="1216" Height="900" MinWidth="960" MinHeight="760"
        FontFamily="{StaticResource BodyFont}" Background="{StaticResource WindowColor}" Foreground="{StaticResource TextColor}"
        WindowStartupLocation="CenterScreen" Icon="/ChessUI;component/Assets/icon.ico">
    <Grid><local:TournamentBackdrop/>
        <Grid Margin="48,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,20"><TextBlock Text="Online game" FontSize="18" VerticalAlignment="Center"/><Button Content="New game" Style="{StaticResource LinkButtonStyle}" DockPanel.Dock="Right" Click="NewGame_Click" HorizontalAlignment="Right"/></DockPanel>
            <StackPanel Grid.Row="1">
                <TextBlock x:Name="Notice" Foreground="{StaticResource AccentColor}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
                <StackPanel x:Name="Lobby" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,20">
                    <TextBlock Text="Play with someone online" FontFamily="{StaticResource HeadingFont}" FontSize="28" Margin="0,0,0,12"/>
                    <TextBlock Text="Server address" Foreground="{StaticResource MutedColor}"/>
                    <TextBox Background="{StaticResource ButtonColor}" Foreground="{StaticResource TextColor}" BorderBrush="{StaticResource StrokeColor}" CaretBrush="{StaticResource TextColor}" x:Name="ServerAddress" Text="https://ayodhettz-chess.vercel.app" Padding="10" FontSize="15" Margin="0,5,0,12" AutomationProperties.Name="Server address"/>
                    <WrapPanel>
                        <RadioButton x:Name="PreferWhite" Content="White" IsChecked="True" GroupName="Seat" Foreground="{StaticResource TextColor}" Margin="0,12,16,0"/>
                        <RadioButton Content="Black" GroupName="Seat" Foreground="{StaticResource TextColor}" Margin="0,12,16,0"/>
                        <Button x:Name="CreateRoom" Content="Create room" Click="Create_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,20,0"/>
                        <TextBox Background="{StaticResource ButtonColor}" Foreground="{StaticResource TextColor}" BorderBrush="{StaticResource StrokeColor}" CaretBrush="{StaticResource TextColor}" x:Name="RoomInput" Width="235" Padding="10" FontSize="14" Margin="0,0,8,0" AutomationProperties.Name="Room code or invitation link"/>
                        <Button x:Name="JoinRoom" Content="Join game" Click="Join_Click" Style="{StaticResource ButtonStyle}"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,12,0,0"><Button x:Name="FindMatch" Content="Find a match" Click="FindMatch_Click" Style="{StaticResource ButtonStyle}"/><Button x:Name="CancelSearch" Content="Cancel search" Click="CancelSearch_Click" Style="{StaticResource LinkButtonStyle}" Visibility="Collapsed"/></WrapPanel>
                    <TextBlock x:Name="SearchStatus" Text="Searching for another player… Colours are assigned randomly. Keep this window open." Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="Paste a room code or a browser invitation link. Keep this window open to retain your seat." Foreground="{StaticResource MutedColor}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </StackPanel>
            <Grid Grid.Row="2" x:Name="MatchPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="Players" Foreground="{StaticResource MutedColor}" Margin="24,0,0,12"/>
                    <Viewbox Stretch="Uniform" MaxWidth="626" HorizontalAlignment="Left">
                        <Grid Width="626" Height="626"><Grid.RowDefinitions><RowDefinition Height="600"/><RowDefinition Height="26"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="600"/></Grid.ColumnDefinitions>
                            <UniformGrid x:Name="Ranks" Rows="8" Columns="1"/>
                            <UniformGrid x:Name="BoardButtons" Grid.Column="1" Rows="8" Columns="8" KeyboardNavigation.TabNavigation="Once"/>
                            <UniformGrid x:Name="Files" Grid.Row="1" Grid.Column="1" Rows="1" Columns="8"/>
                        </Grid>
                    </Viewbox>
                </StackPanel>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock x:Name="Turn" FontFamily="{StaticResource HeadingFont}" FontSize="25" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="ConnectionStatus" Foreground="{StaticResource MutedColor}" Margin="0,10,0,16" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RoomLabel" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,8"/>
                    <Button Content="Copy invitation" Style="{StaticResource LinkButtonStyle}" Click="Copy_Click" Margin="0,0,0,12"/>
                    <TextBlock Text="Moves                 White / Black" Foreground="{StaticResource MutedColor}"/>
                    <TextBox x:Name="History" IsReadOnly="True" Height="160" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" Background="Transparent" Foreground="{StaticResource TextColor}" BorderThickness="0" Margin="0,8,0,14" AutomationProperties.Name="Move history"/>
                    <Button x:Name="Reconnect" Content="Reconnect" Click="Reconnect_Click" Style="{StaticResource ButtonStyle}" Margin="0,0,0,8"/>
                    <Button x:Name="Recover" Content="Recover pending action" Click="Reconnect_Click" Style="{StaticResource ButtonStyle}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="OfferStatus" TextWrapping="Wrap" Foreground="{StaticResource MutedColor}" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="DrawResponse"><Button x:Name="AcceptDraw" Content="Accept draw" Click="Accept_Click" Style="{StaticResource ButtonStyle}" Margin="0,0,8,8"/><Button x:Name="DeclineDraw" Content="Decline" Click="Decline_Click" Style="{StaticResource ButtonStyle}" Margin="0,0,0,8"/></WrapPanel>
                    <Button x:Name="ClaimDraw" Content="Claim draw" Click="Claim_Click" Style="{StaticResource ButtonStyle}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ClaimIntended" Content="Claim with an intended move" Checked="ClaimMode_Changed" Unchecked="ClaimMode_Changed" Foreground="{StaticResource TextColor}" Margin="0,0,0,10"/>
                    <WrapPanel><Button x:Name="OfferDraw" Content="Offer draw" Click="Offer_Click" Style="{StaticResource LinkButtonStyle}" Margin="0,0,24,0"/><Button x:Name="Resign" Content="Resign" Click="Resign_Click" Style="{StaticResource LinkButtonStyle}"/></WrapPanel>
                    <TextBlock Text="Server-validated play. No offline undo, hints, or position editing in online rooms." Foreground="{StaticResource MutedColor}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel></ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
