<Window x:Class="ChessUI.StartWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Chess — New game" Width="960" Height="700"
        MinWidth="860" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowColor}"
        Icon="/ChessUI;component/Assets/icon.ico">
    <Grid Margin="40" Background="{StaticResource WindowColor}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,44,0">
            <TextBlock Text="YOUR NEXT MOVE" Foreground="{StaticResource AccentColor}" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Text="A board.&#10;A fresh start." Foreground="{StaticResource TextColor}" FontSize="44" FontWeight="SemiBold" Margin="0,16,0,16"/>
            <TextBlock Text="Take on our custom chess bot, or share a game with someone beside you." Foreground="{StaticResource MutedColor}" FontSize="17" TextWrapping="Wrap"/>
            <Image Source="Assets/KnightW.png" Height="170" Width="170" HorizontalAlignment="Left" Margin="0,28,0,0"/>
            <TextBlock Text="A little focus. A good game." Foreground="{StaticResource MutedColor}" FontSize="12" Margin="0,14,0,0"/>
        </StackPanel>
        <Border Grid.Column="1" Background="{StaticResource PanelColor}" CornerRadius="16" Padding="28" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="New game" Foreground="{StaticResource TextColor}" FontSize="28" Margin="0,0,0,22"/>
                <Border Style="{StaticResource BorderStyle}" Padding="14" Margin="0,0,0,12">
                    <RadioButton x:Name="BotModeRadio" GroupName="Mode" IsChecked="True" Checked="Mode_Changed" Foreground="{StaticResource TextColor}" VerticalContentAlignment="Center">
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Play the bot" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="A solo game, at your pace." FontSize="12" Foreground="{StaticResource MutedColor}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </Border>
                <Border Style="{StaticResource BorderStyle}" Padding="14" Margin="0,0,0,22">
                    <RadioButton x:Name="LocalModeRadio" GroupName="Mode" Checked="Mode_Changed" Foreground="{StaticResource TextColor}">
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Local two-player" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Two people, one board." FontSize="12" Foreground="{StaticResource MutedColor}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </Border>
                <StackPanel x:Name="ColourPanel">
                    <TextBlock Text="PLAY AS" Foreground="{StaticResource MutedColor}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <UniformGrid Rows="1" Columns="2" Margin="0,0,0,18">
                        <RadioButton x:Name="WhiteRadio" GroupName="Colour" Content="White · move first" IsChecked="True" Foreground="{StaticResource TextColor}"/>
                        <RadioButton x:Name="BlackRadio" GroupName="Colour" Content="Black · bot starts" Foreground="{StaticResource TextColor}"/>
                    </UniformGrid>
                </StackPanel>
                <Button x:Name="StartGameButton" Content="Start game" Style="{StaticResource PrimaryButtonStyle}" Click="StartGame_Click" Padding="16,12"/>
                <TextBlock Text="Suggestions and undo are available during play. Saved games and PGNs can be loaded from the board's File menu." Foreground="{StaticResource MutedColor}" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
