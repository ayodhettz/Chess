<Window x:Class="ChessUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChessUI"
        mc:Ignorable="d"
        Title="Chess" Width="880" Height="680" MinWidth="680" MinHeight="540"
        Icon="/ChessUI;component/Assets/icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#101010"
        PreviewKeyDown="Window_KeyDown">
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Undo}"
                        Executed="Undo_Executed" CanExecute="Undo_CanExecute"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Redo}"
                        Executed="Redo_Executed" CanExecute="Redo_CanExecute"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static ApplicationCommands.Undo}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static ApplicationCommands.Redo}"/>
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{x:Static ApplicationCommands.Redo}"/>
    </Window.InputBindings>
    
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>
    <Viewbox Grid.Column="0">
        <Grid x:Name="BoardGrid"
              Width="600"
              Height="600"
              MouseDown="BoardGrid_MouseDown"
              >
            <Grid.Background>
                <ImageBrush ImageSource="/ChessUI;component/Assets/Board.png"/>
            </Grid.Background>
            <UniformGrid x:Name ="HighlightGrid"
                         Rows="8"
                         Columns="8">
                
            </UniformGrid>

            <UniformGrid x:Name="PieceGrid"
                         Rows="8"
                         Columns="8"
                         RenderOptions.BitmapScalingMode="HighQuality">
                
            </UniformGrid>

            <ContentControl x:Name="MenuContainer"/>
        </Grid>
    </Viewbox>
        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
                <TextBlock x:Name="StatusText" Style="{StaticResource TextStyle}"
                           FontSize="22" TextWrapping="Wrap"/>
                <TextBlock Text="Move history" Style="{StaticResource TextStyle}"
                           FontSize="16" Margin="0,12,0,0"/>
            </StackPanel>
            <ListBox x:Name="HistoryList" Grid.Row="1" FontFamily="Consolas"
                     Background="#202020" Foreground="{StaticResource TextColor}"
                     BorderBrush="{StaticResource StrokeColor}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <StackPanel x:Name="ActionPanel">
                    <TextBlock x:Name="ClaimHintText" Foreground="{StaticResource TextColor}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ClaimWithMoveCheckBox" Content="Claim with next move"
                              Foreground="{StaticResource TextColor}" Margin="0,0,0,8"
                              ToolTip="Select a legal move to claim a draw before playing it."/>
                    <Button x:Name="ClaimDrawButton" Content="Claim draw"
                            Style="{StaticResource ButtonStyle}" Click="ClaimDraw_Click"
                            ToolTip="Claim a draw by repetition or the fifty-move rule."/>
                    <Button Content="Resign" Style="{StaticResource ButtonStyle}"
                            Click="Resign_Click" Margin="0,8,0,0"/>
                </StackPanel>
                <UniformGrid Rows="1" Columns="2" Margin="0,8,0,0">
                    <Button x:Name="UndoButton" Content="Undo" Style="{StaticResource ButtonStyle}"
                            Click="Undo_Click" ToolTip="Undo (Ctrl+Z)" Margin="0,0,4,0"/>
                    <Button x:Name="RedoButton" Content="Redo" Style="{StaticResource ButtonStyle}"
                            Click="Redo_Click" ToolTip="Redo (Ctrl+Y or Ctrl+Shift+Z)" Margin="4,0,0,0"/>
                </UniformGrid>
                <Button x:Name="FenPositionButton" Content="FEN position…" Style="{StaticResource ButtonStyle}"
                        Click="FenPosition_Click" Margin="0,8,0,0"/>
                <TextBlock Text="Escape: pause / continue" Style="{StaticResource TextStyle}"
                           FontSize="12" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
