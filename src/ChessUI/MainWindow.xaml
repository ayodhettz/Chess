<Window x:Class="ChessUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chess" Width="1080" Height="820" MinWidth="900" MinHeight="700"
        Icon="/ChessUI;component/Assets/icon.ico" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowColor}" PreviewKeyDown="Window_KeyDown">
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Undo}" Executed="Undo_Executed" CanExecute="Undo_CanExecute"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Redo}" Executed="Redo_Executed" CanExecute="Redo_CanExecute"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static ApplicationCommands.Undo}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static ApplicationCommands.Redo}"/>
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{x:Static ApplicationCommands.Redo}"/>
    </Window.InputBindings>
    <Grid Margin="24" Background="{StaticResource WindowColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="CHESS / PLAY" Foreground="{StaticResource AccentColor}" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock x:Name="MatchTitleText" Text="Local two-player" FontSize="25" Foreground="{StaticResource TextColor}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="New game" Click="NewGame_Click" Style="{StaticResource ButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
        <Menu Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,16" Background="{StaticResource PanelColor}" Foreground="{StaticResource TextColor}">
            <MenuItem Header="_File">
                <MenuItem x:Name="SaveGameMenuItem" Header="_Save game…" Click="SaveGame_Click" Foreground="#101010"/>
                <MenuItem x:Name="LoadGameMenuItem" Header="_Load game…" Click="LoadGame_Click" Foreground="#101010"/>
                <Separator/>
                <MenuItem x:Name="ImportPgnMenuItem" Header="_Import PGN…" Click="ImportPgn_Click" Foreground="#101010"/>
                <MenuItem x:Name="ExportPgnMenuItem" Header="_Export PGN…" Click="ExportPgn_Click" Foreground="#101010"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem x:Name="BotMoveMenuItem" Header="_Suggest move" Click="SuggestMove_Click" Foreground="#101010"/>
                <MenuItem x:Name="CancelBotMenuItem" Header="_Cancel thinking" Click="CancelBot_Click" Foreground="#101010" IsEnabled="False"/>
            </MenuItem>
        </Menu>
        <Grid Grid.Row="2" Margin="0,0,22,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="OpponentText" Foreground="{StaticResource MutedColor}" FontSize="14" Margin="0,0,0,10"/>
            <Viewbox Grid.Row="1" Stretch="Uniform">
                <Border BorderBrush="{StaticResource StrokeColor}" BorderThickness="6" CornerRadius="4">
                    <Grid x:Name="BoardGrid" Width="600" Height="600" MouseDown="BoardGrid_MouseDown">
                        <UniformGrid x:Name="SquareGrid" Rows="8" Columns="8"/>
                        <UniformGrid x:Name="HighlightGrid" Rows="8" Columns="8" IsHitTestVisible="False"/>
                        <UniformGrid x:Name="PieceGrid" Rows="8" Columns="8" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <ContentControl x:Name="MenuContainer"/>
                    </Grid>
                </Border>
            </Viewbox>
            <TextBlock x:Name="HumanText" Grid.Row="2" Foreground="{StaticResource TextColor}" FontSize="14" Margin="0,10,0,0"/>
        </Grid>
        <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource PanelColor}" CornerRadius="12" Padding="18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="1.5*"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="MATCH" Foreground="{StaticResource MutedColor}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" FontSize="24" Foreground="{StaticResource TextColor}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock x:Name="BotStatusText" Foreground="{StaticResource AccentColor}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="FileStatusText" Foreground="{StaticResource MutedColor}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="MOVE HISTORY" Foreground="{StaticResource MutedColor}" FontSize="11" FontWeight="SemiBold" Margin="0,20,0,0"/>
                </StackPanel>
                <ListBox x:Name="HistoryList" Grid.Row="1" FontFamily="Consolas" FontSize="13" Background="Transparent"
                         Foreground="{StaticResource TextColor}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                <ScrollViewer x:Name="ActionsScrollViewer" Grid.Row="2" MaxHeight="310" VerticalAlignment="Bottom" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0">
                <StackPanel>
                    <Button x:Name="ResumeBotButton" Content="Resume bot" Click="ResumeBot_Click" Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed" Margin="0,0,0,8"/>
                    <Button x:Name="SuggestMoveButton" Content="Suggest move" Click="SuggestMove_Click" Style="{StaticResource ButtonStyle}" Margin="0,0,0,8"/>
                    <StackPanel x:Name="ActionPanel">
                        <TextBlock x:Name="ClaimHintText" Foreground="{StaticResource TextColor}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ClaimWithMoveCheckBox" Content="Claim with next move" Foreground="{StaticResource TextColor}" Margin="0,0,0,8" ToolTip="Select a legal move to claim a draw before playing it."/>
                        <Button x:Name="ClaimDrawButton" Content="Claim draw" Style="{StaticResource ButtonStyle}" Click="ClaimDraw_Click" Margin="0,0,0,8"/>
                        <Button x:Name="OfferDrawButton" Content="Offer draw" Style="{StaticResource ButtonStyle}" Click="OfferDraw_Click" Margin="0,0,0,8" ToolTipService.ShowOnDisabled="True"/>
                        <StackPanel x:Name="DrawOfferPanel" Margin="0,0,0,8" Visibility="Collapsed">
                            <TextBlock x:Name="DrawOfferText" Foreground="{StaticResource TextColor}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
                            <UniformGrid Rows="1" Columns="2">
                                <Button x:Name="AcceptDrawButton" Content="Accept" Style="{StaticResource ButtonStyle}" Click="AcceptDraw_Click" Margin="0,0,4,0"/>
                                <Button x:Name="DeclineDrawButton" Content="Decline" Style="{StaticResource ButtonStyle}" Click="DeclineDraw_Click" Margin="4,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                        <Button Content="Resign" Style="{StaticResource ButtonStyle}" Click="Resign_Click"/>
                    </StackPanel>
                    <UniformGrid Rows="1" Columns="2" Margin="0,8,0,0">
                        <Button x:Name="UndoButton" Content="Undo" Style="{StaticResource ButtonStyle}" Click="Undo_Click" Margin="0,0,4,0" ToolTip="Undo (Ctrl+Z)"/>
                        <Button x:Name="RedoButton" Content="Redo" Style="{StaticResource ButtonStyle}" Click="Redo_Click" Margin="4,0,0,0" ToolTip="Redo (Ctrl+Y)"/>
                    </UniformGrid>
                    <Button x:Name="FenPositionButton" Content="FEN position…" Style="{StaticResource ButtonStyle}" Click="FenPosition_Click" Margin="0,8,0,0"/>
                    <TextBlock Text="Escape to pause / continue" Foreground="{StaticResource MutedColor}" FontSize="11" Margin="0,14,0,0"/>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
