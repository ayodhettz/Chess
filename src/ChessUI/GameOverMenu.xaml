<UserControl x:Class="ChessUI.GameOverMenu" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="330" Padding="22" Style="{StaticResource BorderStyle}">
        <StackPanel>
            <TextBlock x:Name="Winner_Text" Style="{StaticResource TextStyle}" FontSize="26"/>
            <TextBlock x:Name="Reason_Text" Style="{StaticResource TextStyle}" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Margin="0,12,0,20"/>
            <UniformGrid Rows="1" Columns="2">
                <Button Content="Rematch" Style="{StaticResource PrimaryButtonStyle}" Click="Rematch_Button_Click" Margin="0,0,5,0"/>
                <Button Content="Exit game" Style="{StaticResource ButtonStyle}" Click="Exit_Button_Click" Margin="5,0,0,0"/>
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
