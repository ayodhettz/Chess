<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><ProjectReference Include="../ChessLogic/ChessLogic.csproj"/><ProjectReference Include="../Chess.Contracts/Chess.Contracts.csproj"/></ItemGroup>
  <Target Name="BuildWebClient" BeforeTargets="PrepareForBuild" Condition="'$(BuildBrowserAssets)' != 'false'">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/../Chess.Web/scripts/build.mjs&quot;" />
    <ItemGroup>
      <Content Include="wwwroot/**/*" Exclude="@(Content)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
